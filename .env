# ──────────────────────────────────────────────────────────────────
# QCare Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to source control.
# ──────────────────────────────────────────────────────────────────

# PostgreSQL connection string (required)
# Format: postgresql://<user>:<password>@<host>:<port>/<database>
# Example (local):  postgresql://postgres:password@localhost:5432/qcare
# Example (Render): postgresql://user:pass@dpg-xxx.render.com/qcare
DATABASE_URL=postgresql://postgres:Renureddy925@localhost:5432/queuecare
PORT=5000

# Node environment (development | production)
NODE_ENV=production

