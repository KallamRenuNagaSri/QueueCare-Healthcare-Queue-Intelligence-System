# ──────────────────────────────────────────────────────────────────────────────
# QCare – Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to source control.
# ──────────────────────────────────────────────────────────────────────────────

# PostgreSQL connection string (required)
# Format : postgresql://<user>:<password>@<host>:<port>/<database>
# Local  : postgresql://postgres:yourpassword@localhost:5432/qcare
# Neon   : postgresql://user:pass@ep-xxx.us-east-2.aws.neon.tech/qcare?sslmode=require
# Render : provided automatically when a Render PostgreSQL database is attached
DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/qcare

# Server port (optional — defaults to 5000)
PORT=5000

# Node environment
NODE_ENV=production
